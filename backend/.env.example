# Copy this file to ".env" and fill in your real values.
# ".env" is git-ignored so your real credentials never get committed.

# ---- Database ----
# Default: local SQLite file, no extra setup needed.
DATABASE_URL=sqlite:///./edens.db

# ---- Admin dashboard access ----
# Simple password used to log in to /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_TOKEN=change-this-to-a-long-random-secret

# ---- Email (SMTP) ----
# Currently placeholder values — replace with your real email provider details.
# Example for Gmail: use an "App Password", not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Edens Refrigeration and Air-Conditioning
SMTP_FROM_EMAIL=your-email@example.com

# Where new enquiries/reviews get notified
BUSINESS_NOTIFY_EMAIL=edensqueenstownltd@gmail.com

# ---- CORS ----
# Comma-separated list of frontend origins allowed to call this API.
# For local dev with "Live Server" / file:// / simple http.server, * is fine.
ALLOWED_ORIGINS=*
